# MineStormNickSystem configuration.

settings:
  persist-across-sessions: true
  rewrite-chat: true
  rewrite-join-quit: true

# World restrictions were removed. Nicknames apply instantly, everywhere.

actionbar:
  enabled: true
  interval-ticks: 40
  show-when-dormant: true

storage:
  type: sqlite
  sqlite-file: nick.db
  mysql:
    host: localhost
    port: 3306
    database: nicksystem
    username: ""
    password: ""
    use-ssl: false

skins:
  cache-ttl-minutes: 1440
  request-timeout-seconds: 10
  pool-players: []
  pool: []

integrations:
  bedwars:
    enabled: false
    min-stars: 1
    max-stars: 12
    chat-prefix: true
    real-level-placeholder: ""

# ---------------------------------------------------------------------------
# LuckPerms integration - controls who can use /g.
# ---------------------------------------------------------------------------
luckperms:
  enabled: true
  required-group: "prime"
  check-inheritance: true
  tracked-groups:
    - prime
    - elite
    - mvp
  required-permission: "minestormnicksystem.global"
